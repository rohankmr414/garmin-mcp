{
  "name": "garmin-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2025-08-01",
  // global_fetch_strictly_public: required for OAuth Client ID Metadata Documents
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "durable_objects": {
    "bindings": [{ "name": "MCP_OBJECT", "class_name": "GarminMCP" }]
  },
  // new_sqlite_classes = free-tier compatible Durable Objects
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GarminMCP"] }],
  // replace id after: npx wrangler kv namespace create OAUTH_KV
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "3b6609f917ba416fae369ce05853de04" }]
  // OWNER_GARMIN_IDS is a secret, not a committed var:
  //   npx wrangler secret put OWNER_GARMIN_IDS   (your get_user_profile displayName)
}
